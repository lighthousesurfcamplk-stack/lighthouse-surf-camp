# ---------------------------------------------------------------------------
# Light House Surf Camp — payment environment
# ---------------------------------------------------------------------------
# Copy to ".env" for local development (this folder), or paste the same
# variables into Netlify → Site configuration → Environment variables for
# production. Nothing here belongs in git: .env is ignored, .env.example is
# the only copy that is committed.
#
# Only the first two are required for card payments to work. Everything else
# degrades quietly: no Supabase means no stored booking and no guest email,
# but the payment still goes through and the camp is still told.
# ---------------------------------------------------------------------------

# --- PayHere (required) ---------------------------------------------------
# payhere.lk → Settings → Domains & Credentials. The secret signs every
# amount; it must never appear in the browser, in content/settings.json, or
# in a commit.
PAYHERE_MERCHANT_ID=1234567
PAYHERE_MERCHANT_SECRET=YOUR_MERCHANT_SECRET

# Sandbox until the camp has tested with PayHere's published test cards.
# Set to false (and swap in the live credentials) to take real money.
PAYHERE_SANDBOX=true

# --- The site's own address (required in production) -----------------------
# Every return, cancel and notify URL is built from this, never from the
# incoming request, so a forged Host header cannot redirect a guest
# somewhere else. Netlify sets URL automatically; set SITE_URL to override.
SITE_URL=http://localhost:5599

# --- Supabase (optional, but needed for confirmations) --------------------
# Project → Settings → API. Use the SERVICE ROLE key: the bookings table has
# RLS on with no policies, so the anon key can read nothing. Server-side
# only — it bypasses every row-level rule in the database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BOOKINGS_TABLE=bookings

# --- Telegram alert to the camp (optional) -------------------------------
# Talk to @BotFather for the token, then @userinfobot (or the group's
# chat id) for the destination.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (optional) -----------------------------------------------------
# Confirmation to the guest and a copy to the camp, via resend.com.
# The from address must be on a domain verified in Resend.
RESEND_API_KEY=
BOOKING_EMAIL_FROM=Light House Surf Camp <bookings@lighthousesurfcamp.lk>

# --- This standalone server only -----------------------------------------
PORT=3000
